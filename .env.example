# =============================================================================
# Shared env (used by CDK deploy, AWS SDK scripts, and Lambdas at synth time)
# Pick a target by which npm script you run — see diagram in docs/runbook.md
# =============================================================================

AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1
STAGE=dev

# Table / queue names (match CDK in infra/lib/gatehold-stack.ts)
EVENTS_TABLE_NAME=gatehold-dev-events
SEATS_TABLE_NAME=gatehold-dev-seats
ORDERS_TABLE_NAME=gatehold-dev-orders
IDEMPOTENCY_TABLE_NAME=gatehold-dev-idempotency
LEDGER_TABLE_NAME=gatehold-dev-ledger
ORDER_QUEUE_URL=http://localhost:4566/000000000000/gatehold-dev-orders
MOCK_PAYMENT_URL=http://127.0.0.1:8090
ORDER_AMOUNT_CENTS=5000

# Seed defaults
SEED_EVENT_ID=evt_001
SEAT_ID=A-12-01

# -----------------------------------------------------------------------------
# LOCAL (MiniStack) — used by: npm run deploy:local, seed, get-seat
# https://github.com/ministackorg/ministack
# LocalStack-compatible hostnames so aws-cdk-local v3 + S3 routing work.
# -----------------------------------------------------------------------------
AWS_ENDPOINT_URL=http://localhost.localstack.cloud:4566
AWS_ENDPOINT_URL_S3=http://s3.localhost.localstack.cloud:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# -----------------------------------------------------------------------------
# REAL AWS — used by: npm run deploy:aws
# Do NOT set AWS_ENDPOINT_URL / AWS_ENDPOINT_URL_S3 (or unset them).
# Use real credentials instead, e.g.:
#   unset AWS_ENDPOINT_URL AWS_ENDPOINT_URL_S3
#   aws configure   # or AWS_PROFILE=your-profile
# -----------------------------------------------------------------------------
