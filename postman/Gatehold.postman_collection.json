    {
      "name": "Holds",
      "item": [
        {
          "name": "Hold seats",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const j = pm.response.json();",
                  "  pm.environment.set('holdId', j.holdId);",
                  "  if (j.seatIds && j.seatIds.length) {",
                  "    pm.environment.set('seatId', j.seatIds[0]);",
                  "    pm.environment.set('seatIdsJson', JSON.stringify(j.seatIds));",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"seatIds\": [\"{{seatId}}\"]\n}"
            },
            "url": "{{gatewayBase}}/events/{{eventId}}/holds",
            "description": "Reserve seats (HELD). Saves holdId + seatIds for Accept order. See Examples for group/conflict/400."
          },
          "response": [
            {
              "name": "201 single seat",
              "originalRequest": {
