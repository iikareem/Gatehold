{
  "info": {
    "name": "Gatehold (local MiniStack)",
    "description": "Import with Gatehold.postman_environment.json.\\nSelect Gatehold MiniStack → Desktop Agent.\\n\\nFolders: Health, Holds, Orders, Mock payment. Variants are under Examples.\\nAPI flow: Hold seats → Accept order → Get seat (PAYING).\\nMock payment: start `go run ./mock-payment` from go/, then Authorize → Capture or Void.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
