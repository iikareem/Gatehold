    {
      "name": "Mock payment",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{paymentBase}}/health",
            "description": "Smoke the local go/mock-payment process (go run ./mock-payment from go/). Not the API Gateway health."
          },
          "response": [
            {
              "name": "200 ok",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": "{{paymentBase}}/health"
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"ok\": true\n}"
            }
          ]
        },
        {
          "name": "Authorize",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get('paymentOrderId')) {",
                  "  pm.environment.set('paymentOrderId', 'ord_' + Date.now());",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  pm.environment.set('paymentAuthId', j.authorizationId);",
                  "  if (j.orderId) { pm.environment.set('paymentOrderId', j.orderId); }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idempotencyKey\": \"pay:auth:{{paymentOrderId}}\",\n  \"orderId\": \"{{paymentOrderId}}\",\n  \"amount\": {{paymentAmount}},\n  \"currency\": \"USD\"\n}"
            },
            "url": "{{paymentBase}}/v1/payments/authorize",
            "description": "Reserve funds (does not capture). Saves paymentAuthId. Then run Capture or Void. Keys: pay:auth:{orderId}."
          },
          "response": [
            {
              "name": "200 AUTHORIZED",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{paymentBase}}/v1/payments/authorize",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"idempotencyKey\": \"pay:auth:{{paymentOrderId}}\",\n  \"orderId\": \"{{paymentOrderId}}\",\n  \"amount\": {{paymentAmount}},\n  \"currency\": \"USD\"\n}"
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"idempotencyKey\": \"pay:auth:ord_…\",\n  \"orderId\": \"ord_…\",\n  \"authorizationId\": \"auth_…\",\n  \"paymentId\": \"pay_…\",\n  \"status\": \"AUTHORIZED\",\n  \"amount\": 5000,\n  \"currency\": \"USD\"\n}"
            },
            {
              "name": "200 idempotent retry",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{paymentBase}}/v1/payments/authorize",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"idempotencyKey\": \"pay:auth:{{paymentOrderId}}\",\n  \"orderId\": \"{{paymentOrderId}}\",\n  \"amount\": {{paymentAmount}},\n  \"currency\": \"USD\"\n}"
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"idempotencyKey\": \"pay:auth:ord_…\",\n  \"orderId\": \"ord_…\",\n  \"authorizationId\": \"auth_…\",\n  \"paymentId\": \"pay_…\",\n  \"status\": \"AUTHORIZED\",\n  \"amount\": 5000,\n  \"currency\": \"USD\"\n}"
            },
            {
              "name": "400 bad request",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{paymentBase}}/v1/payments/authorize",
                "body": {
