                  }
                ],
                "url": "{{paymentBase}}/v1/payments/authorize",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"idempotencyKey\": \"pay:auth:ord_…\",\n  \"orderId\": \"ord_…\",\n  \"amount\": 9999,\n  \"currency\": \"USD\"\n}"
                }
