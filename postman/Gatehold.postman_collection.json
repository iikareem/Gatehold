        },
        {
          "name": "Capture",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idempotencyKey\": \"pay:capture:{{paymentOrderId}}\",\n  \"orderId\": \"{{paymentOrderId}}\",\n  \"authorizationId\": \"{{paymentAuthId}}\",\n  \"amount\": {{paymentAmount}},\n  \"currency\": \"USD\"\n}"
            },
            "url": "{{paymentBase}}/v1/payments/capture",
            "description": "Capture a prior authorization. Run Authorize first (sets paymentAuthId). Happy path: Authorize → Capture."
          },
          "response": [
            {
              "name": "200 CAPTURED",
