    {
      "name": "Orders",
      "item": [
        {
          "name": "Accept order",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get('idempotencyKey')) {",
                  "  pm.environment.set('idempotencyKey', 'idem-' + Date.now());",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 202) {",
                  "  const j = pm.response.json();",
                  "  pm.environment.set('orderId', j.orderId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"holdId\": \"{{holdId}}\",\n  \"seatIds\": {{seatIdsJson}}\n}"
            },
            "url": "{{gatewayBase}}/orders",
            "description": "Buy an existing hold. Run Holds → Hold seats first (sets holdId + seatIdsJson). Idempotency-Key required. Examples: retry / 400 / 409."
          },
          "response": [
            {
              "name": "202 accepted",
