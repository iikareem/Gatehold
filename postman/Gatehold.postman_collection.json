{
  "info": {
    "name": "Gatehold (local MiniStack)",
    "description": "Import with Gatehold.postman_environment.json.\nSelect environment Gatehold MiniStack → Desktop Agent → run 1→9 in order.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Health — liveness",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{gatewayBase}}/health"
      }
    },
    {
      "name": "2. Health — get seat",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{gatewayBase}}/health?eventId={{eventId}}&seatId=A-12-01"
      }
    },
    {
      "name": "3. Hold — single seat (201)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-User-Id", "value": "{{userId}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"seatIds\": [\"{{seatId}}\"]\n}"
        },
        "url": "{{gatewayBase}}/events/{{eventId}}/holds"
      }
    },
    {
      "name": "4. Hold — conflict (409)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-User-Id", "value": "bob" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"seatIds\": [\"{{seatId}}\"]\n}"
        },
        "url": "{{gatewayBase}}/events/{{eventId}}/holds"
      }
    },
    {
      "name": "5. Hold — group seats (201)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-User-Id", "value": "{{userId}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"seatIds\": [\"A-12-30\", \"A-12-31\"]\n}"
        },
        "url": "{{gatewayBase}}/events/{{eventId}}/holds"
      }
    },
    {
      "name": "6. Hold — group overlap (409)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-User-Id", "value": "bob" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"seatIds\": [\"A-12-31\", \"A-12-32\"]\n}"
        },
        "url": "{{gatewayBase}}/events/{{eventId}}/holds"
      }
    },
    {
      "name": "7. Health — confirm held seat",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{gatewayBase}}/health?eventId={{eventId}}&seatId={{seatId}}"
      }
    },
    {
      "name": "8. Hold — empty seatIds (400)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"seatIds\": []\n}"
        },
        "url": "{{gatewayBase}}/events/{{eventId}}/holds"
      }
    },
    {
      "name": "9. Hold — too many seats (400)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"seatIds\": [\"A-12-01\",\"A-12-02\",\"A-12-03\",\"A-12-04\",\"A-12-05\",\"A-12-06\",\"A-12-07\",\"A-12-08\",\"A-12-09\"]\n}"
        },
        "url": "{{gatewayBase}}/events/{{eventId}}/holds"
      }
    }
  ]
}
